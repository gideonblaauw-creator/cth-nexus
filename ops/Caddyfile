	# BEGIN SUSTENTTIA-PRODUCT
	# Product (FastAPI) first — do not let file_server or Express shadow these.
	@sustenttia_product path / /pagar /pagar/* /plan-1 /plan-2 /plan-3 /revisa-tu-correo /revisa-tu-correo/* /entrar /entrar/* /login /login/* /informe /informe/* /client /client/*
	handle @sustenttia_product {
		reverse_proxy 127.0.0.1:9100
	}
	# END SUSTENTTIA-PRODUCT

	encode gzip
	tls {
		issuer acme {
			preferred_chains {
				root_common_name "ISRG Root X1"
			}
		}
	}
	# Product flow (PR #10/#11) — must beat the June static + Express catch-all
	@product path / /pagar /pagar/* /revisa-tu-correo /revisa-tu-correo/* /entrar /entrar/* /login /login/* /informe /informe/* /client /client/*
	handle @product {
		reverse_proxy 127.0.0.1:9100
	}
	handle /grafana/* {
		reverse_proxy localhost:3000
	}
	handle /static/* {
		reverse_proxy 127.0.0.1:9100
	}
	handle /metrics {
		reverse_proxy 127.0.0.1:9100
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:9100
	}
	handle /admin* {
		reverse_proxy 127.0.0.1:9100
	}
	handle /dashboard* {
		reverse_proxy 127.0.0.1:9100
	}
	handle_path /reporte/* {
		root * /var/www/reportes
		try_files {path} {path}/index.html
		file_server
	}
	handle {
		root * /var/www/evaluations/sustenttia
		@static file {path} {path}/index.html
		handle @static {
			try_files {path} {path}/index.html
			file_server
		}
		handle {
			reverse_proxy 127.0.0.1:3101
		}
	}
	log {
		output file /var/log/caddy/app-sustenttia.log
	}
}

