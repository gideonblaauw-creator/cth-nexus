energiacoop.cleantechhub.net {
    root * /opt/energiacoop/public
    file_server
    encode gzip
    try_files {path} {path}/index.html {path}.html

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    # Immutable assets vs frequently-edited HTML. One blanket 1h rule for both
    # (as the handoff proposed) is wrong in both directions.
    @html not path /assets/*
    header @html Cache-Control "public, max-age=3600"
    header /assets/* Cache-Control "public, max-age=31536000, immutable"

    handle_errors {
        rewrite * /404.html
        file_server
    }
}

# CTH Research — static content for LinkedIn strategy
research.cleantechhub.net {
	encode gzip
	root * /var/www/research
	file_server

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
	}

	# HTML pages — short cache
	@html path *.html
	header @html Cache-Control "public, max-age=3600"

	# Static assets — long cache
	@assets path /images/* /pdfs/* /cards/*
	header @assets Cache-Control "public, max-age=86400"

	log {
		output file /var/log/caddy/research.cleantechhub.net.log {
			roll_size 20mb
			roll_keep 5
		}
		format json
	}
}

