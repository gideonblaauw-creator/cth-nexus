files-mcp.cleantechhub.net {
	handle_path /nexus-assets/* {
		root * /var/www/nexus-assets
		file_server
		header Cache-Control "public, max-age=3600"
	}
	encode gzip
	rate_limit {
		zone files_mcp_per_ip {
			key {client_ip}
			events 60
			window 1m
		}
		zone files_mcp_per_token {
			key {header.Authorization}
			events 600
			window 1h
		}
	}
	reverse_proxy 127.0.0.1:8093 {
		flush_interval -1
	}
	log {
		output file /var/log/caddy/files-mcp.log
		format json
	}
}
plugins.cleantechhub.net {
	handle_path /nexus-assets/* {
		root * /var/www/nexus-assets
		file_server
		header Cache-Control "public, max-age=3600"
	}
	encode gzip
	handle /marketplace.json {
		root * /opt/plugins
		file_server
	}
	handle /install.sh {
		root * /opt/plugins
		header Content-Type text/plain
		file_server
	}
	@authorized header Authorization "Bearer *"
	handle @authorized {
		root * /opt/plugins
		file_server browse
	}
	handle {
		respond "401 Unauthorized · CleantechHUB private marketplace" 401
	}
	log {
		output file /var/log/caddy/plugins.log
		format json
	}
}
