# Origo EUDR Compliance Platform — Frontend + API
origo.data.cleantechhub.net {
	encode gzip

	# API routes (backward-compat — keep on main domain)
	handle /v1/* {
		reverse_proxy localhost:8097 {
			header_up X-Real-IP {remote_host}
			flush_interval -1
		}
	}
	handle /health {
		reverse_proxy localhost:8097
	}
	handle /token {
		reverse_proxy localhost:8097
	}
	handle /docs {
		reverse_proxy localhost:8097
	}
	handle /redoc {
		reverse_proxy localhost:8097
	}
	handle /openapi.json {
		reverse_proxy localhost:8097
	}
	# Track A: Public EUDR risk screener (no auth)
	handle /public/* {
		reverse_proxy localhost:8097 {
			header_up X-Real-IP {remote_host}
		}
	}
	# Sandbox (canned demo responses)
	handle_path /sandbox/* {
		reverse_proxy localhost:8098 {
			flush_interval -1
		}
	}
	# DID document (W3C Decentralized Identifiers)
	handle /.well-known/did.json {
		header Content-Type application/did+ld+json
		root * /opt/origo/api/src/origo/static
		file_server
	}
	# Static maps
	handle /maps/* {
		root * /opt/origo/api/src/origo/static
		file_server
	}
	# Frontend — static HTML (SPA fallback)
	handle {
		root * /opt/origo-ui
		try_files {path} /index.html
		file_server
	}
	header {
		X-Content-Type-Options nosniff
	}
	log {
		output file /var/log/caddy/origo.data.cleantechhub.net.log {
			roll_size 20mb
			roll_keep 5
		}
		format json
	}
}

