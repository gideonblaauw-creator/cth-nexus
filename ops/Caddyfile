			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}
}
# Sustenttia / MB-0 — ESG MCP public ingress.
# Append to /etc/caddy/Caddyfile, then: sudo systemctl reload caddy
#
# Prereq: DNS A record for mcp-esg.cleantechhub.net → VPS IP.
#
# The MCP itself has no auth — the content is public ESG standards. If you want to
# gate access (e.g. keep discovery low), uncomment the basicauth block below OR
# restrict by @allow-ip. Don't add a bearer-token layer unless the Cowork client
# supports setting custom Authorization headers on URL-transport MCPs.
#
# Cowork / Claude Desktop MCP config (paste into claude_desktop_config.json):
#   "esg-sustainability": {
#     "type": "url",
#     "url": "https://mcp-esg.cleantechhub.net/mcp"
#   }

mcp-esg.cleantechhub.net {
	handle_path /nexus-assets/* {
		root * /var/www/nexus-assets
		file_server
		header Cache-Control "public, max-age=3600"
	}
	encode zstd gzip

	# MCP protocol uses Streamable HTTP — sessions can last a while, bodies can
	# be several hundred KB for bulk lookups. Bump the defaults accordingly.
	request_body {
		max_size 5MB
	}

	# (Optional) Restrict to Gideon's known IPs. Uncomment and fill in.
	# @allow-ip remote_ip 1.2.3.4/32 5.6.7.8/32
	# route @allow-ip {
	#     reverse_proxy 127.0.0.1:3002
	# }
	# respond "Forbidden" 403

	# (Optional) HTTP basic auth. Uncomment + generate hash with:
	#     caddy hash-password --plaintext 'your-password'
	# basicauth * {
	#     gideon $2a$14$...
	# }

	reverse_proxy 127.0.0.1:3002 {
		# The MCP transport is Streamable HTTP — needs HTTP/1.1 for SSE.
		transport http {
			versions 1.1 2
		}
		# Pass the mcp-session-id header through verbatim — the MCP server
		# tracks sessions by it and CORS already exposes it.
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output file /var/log/caddy/mcp-esg.cleantechhub.net.log {
			roll_size 50mb
			roll_keep 5
		}
		format json
	}
}

secrets.cleantechhub.net {
	handle_path /nexus-assets/* {
		root * /var/www/nexus-assets
		file_server
		header Cache-Control "public, max-age=3600"
	}
	reverse_proxy 127.0.0.1:8082
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
}

