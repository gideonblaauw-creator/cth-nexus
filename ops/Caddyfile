# CTH Market Research — agents.cleantechhub.net
# Path-based routing: /research → cth-research:8090, /langfuse → langfuse:3004
agents.cleantechhub.net {
	handle_path /nexus-assets/* {
		root * /var/www/nexus-assets
		file_server
		header Cache-Control "public, max-age=3600"
	}
	handle /diagnostico/lead {
		reverse_proxy localhost:5001
	}
	handle /diagnostic-complete {
		reverse_proxy localhost:5001
	}
	handle /telegram-webhook {
		reverse_proxy localhost:5001
	}
	encode gzip zstd
	# Research API + UI
	handle_path /research/* {
		reverse_proxy localhost:8090
	}
	handle /research {
		redir /research/ permanent
	}
	handle_path /diagnostico* {
		root * /var/www/diagnostico
		file_server
	}
	# Diagnostic Lead API
	handle /seo/diagnostic-lead {
		reverse_proxy localhost:8013
	}
	handle /seo/health {
		reverse_proxy localhost:8013
	}
	# SEO static assets (calc.js, diag.js)
	handle_path /seo/static/* {
		root * /var/www/seo-static
		file_server
		header Access-Control-Allow-Origin "*"
		header Cache-Control "no-cache, must-revalidate"
	}
	# Ruta Verde Loop 3
	handle /seo/calculator-lead {
		reverse_proxy localhost:8014
	}
	handle /seo/diagnostic-complete {
		reverse_proxy localhost:8014
	}
	# Ruta Verde Loop 7
	handle_path /ruta-verde/reports/* {
		root * /opt/ruta-verde/reports
		file_server
	}
	handle /ruta-verde/apply-complete {
		reverse_proxy localhost:8014
	}
	# SEO / AEO agent
	handle /seo/* {
		reverse_proxy localhost:8090
	}
	# Content Publishing agent
	handle /content/* {
		reverse_proxy localhost:8090
	}
	# Grant Discovery + Lifecycle agent
	handle /grant/* {
		reverse_proxy localhost:8090
	}
	# Root — list available agents
	handle / {
		respond "CleantechHUB Agents" 200
	}
	log {
		output file /var/log/caddy/agents.log
		format json
	}
	# Impact Reporting API
	handle /impact-reporting/* {
		reverse_proxy localhost:8005
	}
	handle /impact-reporting {
		redir /impact-reporting/ permanent
	}
}

