nexus.cleantechhub.net {
	# Public MubOn entry (canonical app remains on evaluations)
	handle /mubon* {
		redir https://evaluations.cleantechhub.net{uri} permanent
	}
	handle /nexus-assets/epic-angels-shareable.json {
		root * /var/www/nexus-assets
		rewrite * /epic-angels-shareable.json
		file_server
		header Cache-Control "no-cache, must-revalidate"
	}
	handle_path /nexus-assets/* {
		root * /var/www/nexus-assets
		file_server
		header Cache-Control "public, max-age=3600"
	}
	handle /robots.txt {
		root * /var/www/seo-static
		rewrite * /nexus_robots.txt
		file_server
	}
	handle /registration/* {
		root * /var/www/nexus
		file_server
	}
	handle /p/home {
		header Cache-Control "no-cache, must-revalidate"
		root * /var/www/nexus
		rewrite * /nexus-homepage.html
		file_server
	}
	handle /nexus-auth* {
		reverse_proxy 127.0.0.1:5050
	}
	handle_path /investors* {
		forward_auth 127.0.0.1:5050 {
			uri /nexus-auth/check
			copy_headers Cookie
		}
		root * /opt/nexus-investors/dist
		try_files {path} /index.html
		file_server
	}
	handle /p/funders {
		forward_auth 127.0.0.1:5050 {
			uri /nexus-auth/check
			copy_headers Cookie
		}
		root * /var/www/nexus
		rewrite * /funders.html
		file_server
	}
	handle /p/startup-portfolio {
		header Cache-Control "no-cache, must-revalidate"
		root * /var/www/nexus
		rewrite * /startup-portfolio.html
		file_server
	}
	handle /p/ideas {
		root * /var/www/nexus
		rewrite * /idea-browser.html
		file_server
	}
	handle / {
		redir https://nexus.cleantechhub.net/p/home permanent
	}
	encode gzip zstd
	header {
		X-Frame-Options SAMEORIGIN
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	# CLP26 Mentoring Platform (Flask on :5050)
	handle /mentoring/* {
		reverse_proxy 127.0.0.1:5050
	}
	handle /mentor-api/* {
		reverse_proxy 127.0.0.1:5050
	}
	# Mentor directory static page
	handle /mentor-directory* {
		root * /opt/cth-nexus/static
		file_server
		try_files {path} {path}/index.html
	}
	# REIN Hubs (static at /opt/cth-nexus/static/hubs)
	handle /hubs* {
		header Cache-Control "no-cache, must-revalidate"
		root * /opt/cth-nexus/static
		file_server
		try_files {path} {path}/index.html
	}
	redir /p/mentors /mentor-directory 301
	# Idea Browser (Next.js app embedded as HumHub widget)
	handle /ideas* {
		reverse_proxy 127.0.0.1:3010
	}
	# ── Startup one-pagers (static HTML at /s/{slug}) ──
	handle_path /s/* {
		root * /opt/nexus-onepagers
		try_files {path}/index.html {path}
		file_server
	}
	# Phase D Data Platform API
	handle_path /data/* {
		reverse_proxy 127.0.0.1:8011
	}
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}

}

