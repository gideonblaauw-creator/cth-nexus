		format json
	}
}
# Caddy block for the Doctor_Bot MCP server.
# Append to /etc/caddy/Caddyfile and `caddy reload`.
#
# Bearer-token auth is enforced HERE so the FastMCP server only binds to
# 127.0.0.1 and never sees an unauthenticated request. Set DOCTOR_MCP_TOKEN
# in /etc/default/caddy (or wherever Caddy reads its environment from).
#
#   echo 'DOCTOR_MCP_TOKEN=<REDACTED> | sudo tee -a /etc/default/caddy
#   sudo systemctl restart caddy

doctor-mcp.apps.cleantechhub.net {
	handle_path /nexus-assets/* {
		root * /var/www/nexus-assets
		file_server
		header Cache-Control "public, max-age=3600"
	}
	encode gzip
	# Reject requests without the right bearer header.
	@authorized header Authorization "Bearer {$DOCTOR_MCP_TOKEN}"
	handle @authorized {
		reverse_proxy 127.0.0.1:8766 {
			# MCP streamable-http needs flush + long timeouts for tool calls
			# like force_run() that take ~30s.
			flush_interval -1
			transport http {
				read_timeout 5m
				write_timeout 5m
			}
		}
	}
	# Anything without a valid bearer gets 401 — no leaking server existence.
	handle {
		respond "unauthorized" 401 {
			close
		}
	}
	log {
		output file /var/log/caddy/doctor-mcp.access.log
		format json
	}
}
